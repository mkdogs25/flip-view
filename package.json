{
  "name": "flip-view",
  "version": "0.4.0",
  "description": "View your Obsidian vault as notebooks on a desk, with a page-flipping animation, handwritten or text previews and procedurally generated covers.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "harness": "node dev/build-harness.mjs",
    "bump": "node scripts/bump.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "marked": "^12.0.2",
    "obsidian": "latest",
    "tslib": "^2.6.3",
    "typescript": "^5.5.4"
  }
}
